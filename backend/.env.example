# ──────────────────────────────────────────────
# AMD AgentForge — Environment Configuration
# ──────────────────────────────────────────────

# --- Inference ---
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_URL=http://localhost:8000/v1
INFERENCE_BACKEND=auto
# auto | vllm_rocm | vllm_cuda | hf_api | llama_cpp

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8080
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Sandbox ---
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_ENABLED=true

# --- Deployment (Optional) ---
VERCEL_TOKEN=
RENDER_API_KEY=
